{
  "expo": {
    "name": "مرکز فرماندهی",
    "slug": "command-center-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.commandcenter.planner"
    },
    "android": {
      "package": "com.commandcenter.planner",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#090A0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECORD_AUDIO",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090A0F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#10B981",
          "defaultChannel": "command-center-tasks"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "مرکز فرماندهی برای ثبت صوتی ماموریت‌ها به دسترسی به میکروفون نیاز دارد.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}
